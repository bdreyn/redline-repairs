<section id="{{ block.id or 'services' }}">
  <div class="container">
    <div class="section-header">
      {% if block.label %}<span class="section-label">{{ block.label }}</span>{% endif %}
      <h2>{{ block.heading }}</h2>
      {% if block.subheading %}<p>{{ block.subheading }}</p>{% endif %}
    </div>
    <div class="services-grid" id="servicesGrid">
      {% for service in services %}
      <div class="service-card{% if service.featured %} service-card--featured{% endif %}">
        {% if service.featured %}<span class="service-featured-badge">Featured</span>{% endif %}
        {% if service.image %}
        <img src="{{ service.image }}" alt="{{ service.name }}" loading="lazy">
        {% else %}
        <div class="service-img-placeholder"><i data-lucide="wrench"></i></div>
        {% endif %}
        <div class="service-body">
          <h3>{{ service.name }}</h3>
          <p>{{ service.description }}</p>
          <button class="btn-service" data-service="{{ service.name }}">
            <span>Request This Service</span>
            <i data-lucide="arrow-right"></i>
          </button>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="section-cta">
      <p>Don't see what you're looking for?</p>
      <a href="{{ '' if page.url == '/' else '/' }}#contact" class="btn-outline">Contact Us for Custom Service</a>
    </div>
  </div>
</section>
