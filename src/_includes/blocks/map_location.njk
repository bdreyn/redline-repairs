<section id="{{ block.id or 'location' }}">
  <div class="container">
    <div class="section-header">
      {% if block.label %}<span class="section-label">{{ block.label }}</span>{% endif %}
      <h2>{{ block.heading }}</h2>
      {% if block.subheading %}<p>{{ block.subheading }}</p>{% endif %}
    </div>
    <div class="location-grid">
      <div class="location-left">
        <div class="map-wrap">
          <div id="map"></div>
          <div class="map-fallback" id="mapFallback">
            <a href="{{ site.map.fallback_url }}" target="_blank" rel="noopener" class="map-link-btn">
              <i data-lucide="map-pin"></i> Open in Google Maps
            </a>
          </div>
        </div>
        <div class="info-cards">
          <div class="info-card">
            <i data-lucide="map-pin"></i>
            <div>
              <strong>Address</strong>
              <a href="{{ site.map.address_url }}" target="_blank" rel="noopener">
                {{ site.business.address_line1 }}<br>{{ site.business.address_line2 }}
              </a>
            </div>
          </div>
          <div class="info-card">
            <i data-lucide="phone"></i>
            <div>
              <strong>Phone</strong>
              <a href="tel:{{ site.business.phone_tel }}">{{ site.business.phone }}</a>
            </div>
          </div>
          <div class="info-card">
            <i data-lucide="clock"></i>
            <div>
              <strong>Hours</strong>
              <span>Mon – Fri: {{ site.business.hours.mon_fri }}</span>
              <span>Sat: {{ site.business.hours.saturday }}</span>
              <span>Sun: {{ site.business.hours.sunday }}</span>
            </div>
          </div>
          <div class="info-card">
            <i data-lucide="mail"></i>
            <div>
              <strong>Email</strong>
              <a id="contactEmail" href="#" onclick="return false;">Loading...</a>
            </div>
          </div>
        </div>
      </div>

      <div class="location-right" id="contact">
        <form class="contact-form" id="contactForm">
          <h3>Send Us a Message</h3>

          <div class="form-success" id="formSuccess" style="display:none">
            Thank you! We've received your message and will get back to you soon.
          </div>
          <div class="form-error" id="formError" style="display:none"></div>

          <div class="form-group">
            <label for="fname">Full Name <span>*</span></label>
            <input type="text" id="fname" name="name" required placeholder="John Doe" />
          </div>
          <div class="form-group">
            <label for="femail">Email Address <span>*</span></label>
            <input type="email" id="femail" name="email" required placeholder="john@example.com" />
          </div>
          <div class="form-group">
            <label for="fphone">Phone Number</label>
            <input type="tel" id="fphone" name="phone" placeholder="(123) 456-7890" />
          </div>
          <div class="form-group">
            <label for="fsubject">Subject <span>*</span></label>
            <select id="fsubject" name="subject" required>
              <option value="">Select a subject</option>
              <option>General Inquiry</option>
              <option>Service Question</option>
              <option>Appointment Request</option>
              <option>Custom Service</option>
              <option>Feedback</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="fmessage">Message <span>*</span></label>
            <textarea id="fmessage" name="message" required rows="5" placeholder="Tell us how we can help you..."></textarea>
          </div>

          <div class="hp-field" aria-hidden="true">
            <label for="fwebsite">Website</label>
            <input type="text" id="fwebsite" name="website" tabindex="-1" autocomplete="off" />
          </div>

          {% if site.security.turnstile_site_key %}
          <div class="cf-turnstile" data-sitekey="{{ site.security.turnstile_site_key }}"></div>
          {% endif %}

          <button type="submit" class="btn-submit" id="submitBtn">
            <i data-lucide="send"></i> Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
